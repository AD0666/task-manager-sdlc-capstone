{
  "name": "task-manager",
  "version": "1.0.0",
  "description": "AI-Assistant-Driven SDLC Capstone - Task Manager",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install --prefix tests",
